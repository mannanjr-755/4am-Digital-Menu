# Copy this file to .env (repo root) and fill in values.
# Both frontend and backend load env from the repo root.

# PostgreSQL (Neon / production) — required:
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require"

# Local SQLite alternative (also set provider = "sqlite" in backend/prisma/schema.prisma):
# DATABASE_URL="file:./dev.db"

AUTH_SECRET="generate-a-long-random-string"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BACKEND_URL="http://localhost:4000"

# CRM dashboard (orders from this menu appear there when both share DATABASE_URL)
# Production: https://flowercrm.vercel.app
NEXT_PUBLIC_CRM_URL="http://localhost:3001"
